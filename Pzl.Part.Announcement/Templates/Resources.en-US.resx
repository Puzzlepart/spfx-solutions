  </data>
  <data name="SiteFields_Content_DisplayName" xml:space="preserve">
    <value>Content (Description/consequences)</value>
  </data>
  <data name="SiteFields_Content_Description" xml:space="preserve">
    <value>What has happened or will happen, and what does it mean for users? For planned maintenance: state when the work starts and ends.</value>
  </data>
  <data name="SiteFields_StartDate_DisplayName" xml:space="preserve">
    <value>Startdate</value>
  </data>
  <data name="SiteFields_StartDate_Description" xml:space="preserve">
