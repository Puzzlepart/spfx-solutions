  </data>
  <data name="SiteFields_Consequences_DisplayName" xml:space="preserve">
    <value>Consequences after resolution</value>
  </data>
  <data name="SiteFields_Consequences_Description" xml:space="preserve">
    <value>Consequences that last after the issue is resolved, for example that something must be done again. Leave empty if there are none.</value>
  </data>
  <data name="SiteFields_Responsible_DisplayName" xml:space="preserve">
    <value>Responsible</value>
  </data>
  <data name="SiteFields_Responsible_Description" xml:space="preserve">
