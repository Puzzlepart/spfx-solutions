  <data name="SiteFields_Severity_DisplayName" xml:space="preserve">
    <value>Message level</value>
  </data>
  <data name="SiteFields_Severity_Description" xml:space="preserve">
    <value>How serious is this for users? Critical: many cannot do their work. Warning: something is slow or partly unavailable. Information: no impact now, but good to know.</value>
  </data>
  <data name="SiteFields_Severity_Choice_Info" xml:space="preserve">
