{
  "name": "pzl-announcement-notification",
  "version": "1.0.0",
  "description": "Timer-triggered Azure Function that sends Teams activity notifications for SharePoint news pages and announcements (Pzl.Part.Announcement)",
  "private": true,
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "lint": "prettier \"src/**/*.ts\" --check",
    "prettier": "prettier \"src/**/*.ts\" --write --log-level silent"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.1",
    "@azure/functions": "^4.7.0",
    "@azure/identity": "^4.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.0"
  }
}
