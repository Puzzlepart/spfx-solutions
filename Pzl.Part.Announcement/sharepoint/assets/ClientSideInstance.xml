<?xml version="1.0" encoding="utf-8"?>
<!--
  Tenant-wide registration of the AnnouncementBanner customizer. When the package is deployed
  tenant-wide ("make available to all sites"), SharePoint adds this row to the "Tenant Wide
  Extensions" list in the app catalog. With no targeting the banner is shown nowhere: edit the
  row's properties (listSiteUrl, siteUrls, hubSiteUrls) to turn it on, see README.md.
-->
<Elements xmlns="http://schemas.microsoft.com/sharepoint/">
  <ClientSideComponentInstance
    Title="AnnouncementBanner"
    Location="ClientSideExtension.ApplicationCustomizer"
    ComponentId="c0d1edf4-db39-4feb-8052-a4c27ffe1954"
    Properties="{&quot;listSiteUrl&quot;:&quot;&quot;,&quot;siteUrls&quot;:[],&quot;hubSiteUrls&quot;:[],&quot;targetAudience&quot;:false}">
  </ClientSideComponentInstance>
</Elements>
